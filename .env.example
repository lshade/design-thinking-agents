# Local API mode
MOCK_AGENTS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174
VITE_USE_BACKEND=true

# Microsoft Agent Framework + Foundry mode
# MOCK_AGENTS=false
# FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-project>.services.ai.azure.com
# FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o-mini
# FOUNDRY_WORKER_MODEL_DEPLOYMENT_NAME=gpt-4o-mini
# FOUNDRY_REVIEWER_MODEL_DEPLOYMENT_NAME=<strong-reasoning-deployment>
# FOUNDRY_FACILITATOR_MODEL_DEPLOYMENT_NAME=<strong-reasoning-deployment>
# FOUNDRY_FINAL_MODEL_DEPLOYMENT_NAME=<strong-reasoning-deployment>

# Azure Container Apps managed identity, set by Bicep when enabled
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
